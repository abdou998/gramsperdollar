---
import { publishedPosts } from '../lib/posts';
import Base from '../layouts/Base.astro';
import Leaderboard from '../components/Leaderboard.astro';
import RecipeList from '../components/RecipeList.astro';
import { formatDate, leanness, usd, storeInfo, rankUrl, storeViews, bestFoods, states, storeRank, monthLabel } from '../lib/data';
import { unpricedRecipes } from '../lib/unpriced';

const views = storeViews().map((v) => {
  const foods = bestFoods(v.ids);
  return { ...v, top: foods.slice(0, 4), lean: foods.find((r) => leanness(r.protein_share).key === 'lean'), n: foods.length };
});
const nStores = views[0].ids.length;
const groups = [...new Set(views.map((v) => v.group).filter(Boolean))] as string[];
const where = (id: string) => `${storeInfo(id).store}, ${storeInfo(id).city}`;
const checked = views[0].ids.flatMap((id) => storeRank(id).map((r) => r.checked)).sort()[0];
const stateCards = states().map((st) => ({ ...st, ids: st.ids.filter((id) => storeRank(id).length >= 10) })).filter((st) => st.ids.length);

const fresh = (await unpricedRecipes()).slice(0, 4);
const posts = await publishedPosts();

const site = Astro.site!.href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Grams per Dollar', url: site,
    description: 'High-protein meal prep on a budget, with real supermarket prices and grams of protein per dollar.' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Grams per Dollar', url: site,
    logo: new URL('/favicon.svg', site).href, description: 'Independent site pricing high-protein recipes and groceries at US supermarkets.' },
];
---
<Base
  title="High-Protein Meal Prep on a Budget | Grams per Dollar"
  fullTitle
  description="High-protein meal prep priced at real US supermarkets. Every recipe shows protein per serving, cost per serving and grams of protein per dollar."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-text">
      <h1>High-protein meal prep, priced by the gram</h1>
      <p class="lede">
        We cost every recipe at real supermarkets and show how many grams of protein each dollar buys.
        The higher the yellow number, the better the value.
      </p>
      <div class="picker">
        <label for="shop">Where do you shop?</label>
        <select id="shop">
          <option value="all">All {nStores} stores we price</option>
          {groups.map((g) => (
            <optgroup label={g}>
              {views.filter((v) => v.group === g).map((v) => <option value={v.key}>{v.label}</option>)}
            </optgroup>
          ))}
        </select>
      </div>
    </div>

    <aside class="shelf panel" aria-labelledby="cheapest">
      <h2 id="cheapest">Cheapest protein right now</h2>
      {views.map((v, i) => (
        <div class="view" data-view={v.key} hidden={i > 0}>
          <ol class="mini">
            {v.top.map((r) => (
              <li>
                <span class="tag tag-sm"><span class="tag-number">{r.protein_per_dollar.toFixed(1)}</span><span class="tag-unit">g protein<br />per $1</span></span>
                <span><span class="mini-name">{r.name}</span><span class="small muted">30 g of protein for {usd(r.cost_per_30g!)}{v.ids.length > 1 && <> at {where(r.store)}</>}</span></span>
              </li>
            ))}
          </ol>
          {v.lean && <p class="small">Cheapest lean protein: <strong>{v.lean.name.toLowerCase()}</strong>, {v.lean.protein_per_dollar.toFixed(1)} g per $1{v.ids.length > 1 && <> at {where(v.lean.store)}</>}.</p>}
          <p class="small">{v.ids.length === 1
            ? <a href={rankUrl(v.ids[0])}>All {v.n} foods at {storeInfo(v.ids[0]).store}, ranked</a>
            : <a href="/cheapest-protein">All foods, store by store</a>}
            <span class="muted"> Shelf prices checked {monthLabel(checked)}.</span>
          </p>
        </div>
      ))}
    </aside>
  </section>

  <section aria-labelledby="best-value">
    <div class="sec-head">
      <h2 id="best-value">Best-value recipes</h2>
      <p><a href="/recipes">All recipes</a></p>
    </div>
    {views.map((v, i) => <div class="view" data-view={v.key} hidden={i > 0}><Leaderboard ids={v.ids} /></div>)}
    <p class="planner-cta panel">
      <span>Pick recipes, set the days, and get one shopping list with the checkout total.</span>
      <a class="btn" href="/planner">Plan your week</a>
    </p>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="guides">
      <div class="sec-head">
        <h2 id="guides">Guides and store comparisons</h2>
        <p><a href="/guides">All guides</a></p>
      </div>
      <ul class="posts">
        {posts.slice(0, 4).map((p) => (
          <li>
            <a class="post-title" href={`/${p.id}`}>{p.data.title}</a>
            <p class="post-desc">{p.data.description}</p>
            <p class="small muted"><time datetime={p.data.published.toISOString()}>{formatDate(p.data.published)}</time></p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="by-state">
    <h2 id="by-state">Compare stores in your state</h2>
    <ul class="states">
      {stateCards.map((st) => (
        <li class="panel">
          <a class="state-name" href={`/cheapest-protein#${st.slug}`}>{st.state}</a>
          <p class="small">{st.ids.map((id) => storeInfo(id).store).join(', ')} in {[...new Set(st.ids.map((id) => storeInfo(id).city))].join(', ')}</p>
        </li>
      ))}
    </ul>
    <p class="small muted">We only compare stores in the same state. More states and chains are on the way.</p>
  </section>

  {fresh.length > 0 && (
    <section aria-labelledby="new-recipes">
      <h2 id="new-recipes">New in the kitchen</h2>
      <p class="muted">Just cooked and written up. Prices and protein are added once each ingredient is checked.</p>
      <RecipeList unpriced={fresh} />
    </section>
  )}

  <section aria-labelledby="how" class="how">
    <h2 id="how">How the numbers work</h2>
    <dl>
      <div><dt>Real store prices</dt><dd>Each store's own website, for one named store, at the regular price. Every page says when we checked.</dd></div>
      <div><dt>Only what you use</dt><dd>A recipe's cost counts the grams it uses, not the whole pack. Shopping lists show the full checkout total too.</dd></div>
      <div><dt>Cooked at home</dt><dd>The recipes are ones we make ourselves. Protein comes from USDA data and product labels.</dd></div>
    </dl>
    <p><a href="/about">More about us and how we check prices</a></p>
  </section>
</Base>

<script>
  // Remembers the pick. A single store is also handed to the planner (gpd-store).
  const sel = document.getElementById('shop') as HTMLSelectElement;
  const views = document.querySelectorAll<HTMLElement>('.view');
  function show(key: string) {
    if (![...views].some((v) => v.dataset.view === key)) key = 'all';
    sel.value = key;
    views.forEach((v) => (v.hidden = v.dataset.view !== key));
  }
  let start = 'all';
  try { start = localStorage.getItem('gpd-home-view') || 'all'; } catch {}
  show(start);
  sel.addEventListener('change', () => {
    show(sel.value);
    try {
      localStorage.setItem('gpd-home-view', sel.value);
      if (/-[a-z]{2}$/.test(sel.value)) localStorage.setItem('gpd-store', sel.value);
    } catch {}
  });
</script>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 2rem 3rem; align-items: start; margin: 1rem 0 1rem; }
  .hero h1 { font-size: clamp(2.4rem, 6.5vw, 3.9rem); line-height: 1.02; letter-spacing: -0.035em; font-weight: 800; }
  .lede { font-size: var(--step-1); line-height: 1.5; max-width: var(--measure); margin-top: 1.1rem; }
  .picker { margin: 1.5rem 0 0; }
  .picker label { display: block; font-family: var(--display); font-weight: 650; margin-bottom: 0.4rem; }
  .picker select { max-width: 100%; }
  .shelf h2 { font-size: var(--step-1); margin: 0 0 0.75rem; }
  .mini { list-style: none; padding: 0; margin: 0 0 0.75rem; }
  .mini li { display: grid; grid-template-columns: 6.5rem 1fr; column-gap: 0.9rem; align-items: center; padding: 0.55rem 0; margin: 0; }
  .mini li + li { border-top: 1px solid var(--rule); }
  .mini-name { display: block; font-family: var(--display); font-weight: 700; font-size: 1.1rem; line-height: 1.2; }
  section { margin-top: 3.5rem; }
  .hero { margin-top: 1rem; }
  section h2 { font-size: var(--step-2); margin: 0 0 1rem; }
  .sec-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 1rem; }
  .sec-head p { margin: 0 0 1rem; font-family: var(--display); font-weight: 600; }
  .planner-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; margin-top: 1.5rem; }
  .planner-cta span { max-width: 30rem; }
  .posts { list-style: none; padding: 0; max-width: var(--measure); }
  .posts li { padding: 1rem 0; border-top: 1px solid var(--rule); margin: 0; }
  .post-title { font-family: var(--display); font-weight: 700; font-size: var(--step-1); line-height: 1.25; color: var(--ink); }
  .post-title:hover { color: var(--basil); }
  .post-desc { margin: 0.4rem 0 0.2rem; }
  .states { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; }
  .states li { margin: 0; padding: 1.1rem 1.25rem; }
  .states p { margin: 0.3rem 0 0; }
  .state-name { font-family: var(--display); font-weight: 750; font-size: var(--step-1); color: var(--ink); }
  .how dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem 2rem; margin: 0 0 1rem; }
  .how dt { font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
  .how dd { margin: 0.3rem 0 0; }
  @media (max-width: 48rem) { .hero { grid-template-columns: 1fr; } }
</style>
