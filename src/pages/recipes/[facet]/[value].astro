---
// Category pages, e.g. /recipes/meal/breakfast or /recipes/cost/under-2-dollars.
// Generated for every category in publishedCategories() (3+ recipes). Store pages show that store's prices.
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RecipeList from '../../../components/RecipeList.astro';
import CategoryLinks from '../../../components/CategoryLinks.astro';
import { publishedCategories, duplicatesAll, type Category } from '../../../lib/taxonomy';
import { storeStats, homeStore, storeShort, storeInfo, usd } from '../../../lib/data';

export function getStaticPaths() {
  return publishedCategories().map((c) => {
    const [facet, value] = c.url.replace('/recipes/', '').split('/');
    return { params: { facet, value }, props: { c } };
  });
}

const { c } = Astro.props as { c: Category };
const recipes = [...c.recipes].sort(
  (a, b) => (storeStats(b, c.store)?.protein_g_per_dollar ?? 0) - (storeStats(a, c.store)?.protein_g_per_dollar ?? 0),
);
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: recipes.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/recipes/${r.slug}`, Astro.site).href })),
};
// Intro written from the data, so it stays true as recipes and prices change.
const at = (r: (typeof recipes)[number]) => c.store ?? homeStore(r)!;
const costs = recipes.map((r) => storeStats(r, at(r))!.cost_per_serving);
const prot = recipes.map((r) => Math.round(r.protein_g_per_serving));
const best = recipes[0];
const bestS = storeStats(best, at(best))!;
const where = c.store ? `at ${storeInfo(c.store).store} in ${storeInfo(c.store).city}` : 'at the cheapest store we price for each one';
const intro = `${recipes.length} recipes, ${Math.min(...prot)} to ${Math.max(...prot)} g of protein a serving, costing ${usd(Math.min(...costs))} to ${usd(Math.max(...costs))} a serving ${where}. `
  + `Best value right now: ${best.name.charAt(0).toLowerCase() + best.name.slice(1)}, ${bestS.protein_g_per_dollar} g of protein per $1${c.store ? '' : ` at ${storeShort(at(best))}`}.`;
const description = `${recipes.length} ${c.description.charAt(0).toLowerCase() + c.description.slice(1).replace(/\.$/, '')}, from ${usd(Math.min(...costs))} a serving.`.slice(0, 158);
const siblings = publishedCategories().filter((x) => x.facet === c.facet && x.url !== c.url);
---
<Base title={c.title} description={description} jsonLd={[itemList]} canonical={duplicatesAll(c) ? '/recipes' : undefined}>
  <Breadcrumbs trail={[{ name: 'Home', url: '/' }, { name: 'Recipes', url: '/recipes' }, { name: c.title, url: c.url }]} />
  <h1 class="page-title">{c.title}</h1>
  <p class="lede">{c.description} {intro} Listed best value first.</p>
  <RecipeList recipes={recipes} store={c.store} />
  <CategoryLinks categories={siblings} heading={`Other ${c.facetName.toLowerCase()} options`} />
</Base>

<style>
  .page-title { font-size: var(--step-3); }
  .lede { max-width: var(--measure); }
</style>
