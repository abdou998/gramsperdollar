---
// One page per recipe: the full recipe (with Recipe schema), where it's featured, and related recipes.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import RecipeList from '../../components/RecipeList.astro';
import { allRecipes, getRecipe, storeStats, homeStore, storeShort, usd, recipeTitle } from '../../lib/data';
import { recipeImage } from '../../lib/images';
import { photoFor } from '../../lib/unpriced';
import { categoriesFor } from '../../lib/taxonomy';
import { postsFeaturing } from '../../lib/posts';
import UnpricedRecipe from '../../components/UnpricedRecipe.astro';
import { unpricedRecipes, type Unpriced } from '../../lib/unpriced';

export async function getStaticPaths() {
  return [
    ...allRecipes().map((r) => ({ params: { slug: r.slug }, props: { draft: undefined } })),
    ...(await unpricedRecipes()).map((u) => ({ params: { slug: u.slug }, props: { draft: u } })),
  ];
}

const { draft } = Astro.props as { draft?: Unpriced };

const r = draft ? undefined : getRecipe(Astro.params.slug!);
const s = r && storeStats(r);
const home = r && homeStore(r);
const cats = r ? categoriesFor(r) : [];
const featured = r ? await postsFeaturing(r.slug) : [];
const meal = r?.meal ?? draft!.meal;
const slug = Astro.params.slug!;

// Related: same meal type first, then best protein per dollar.
const related = allRecipes()
  .filter((x) => x.slug !== slug)
  .sort((a, b) => Number(b.meal === meal) - Number(a.meal === meal)
    || (storeStats(b)?.protein_g_per_dollar ?? 0) - (storeStats(a)?.protein_g_per_dollar ?? 0))
  .slice(0, 3);

// Lead with what makes someone click: protein, price, time. Then the dish.
const total = r ? (r.prep_minutes ?? 0) + ((r as any).cook_minutes ?? 0) : 0;
const clip = (t: string, n = 155) => (t.length <= n ? t : t.slice(0, n - 1).replace(/\s+\S*$/, '') + '…');
const description = r
  ? clip([`${Math.round(r.protein_g_per_serving)} g protein`, s ? `${usd(s.cost_per_serving)} a serving` : '', total ? `${total} minutes` : '']
      .filter(Boolean).join(', ') + `. ${r.description}`)
  : clip(draft!.intro[0] ?? `${draft!.title}, a high-protein ${draft!.meal} recipe by ${draft!.author}.`);
const name = r?.name ?? draft!.title;
const photo = r ? recipeImage(r.image) : photoFor(draft!);
const ogImage = photo ? new URL(photo.src, Astro.site).href : undefined;
---
<Base title={r ? recipeTitle(r) : name} description={description} type="article" image={ogImage}>
  <Breadcrumbs trail={[{ name: 'Home', url: '/' }, { name: 'Recipes', url: '/recipes' }, { name, url: `/recipes/${slug}` }]} />
  {r ? <RecipeCard slug={r.slug} headingLevel={1} /> : <UnpricedRecipe r={draft!} />}

  {(featured.length > 0 || cats.length > 0) && (
    <aside class="more">
      {featured.length > 0 && (
        <p>
          <strong>Part of:</strong>{' '}
          {featured.map((p, i) => <>{i > 0 && ', '}<a href={`/${p.id}`}>{p.data.title}</a></>)}
        </p>
      )}
      {cats.length > 0 && (
        <>
          <p class="chips-label"><strong>More like this</strong></p>
          <ul class="chips">{cats.filter((c) => c.facet !== 'store').map((c) => <li><a href={c.url}>{c.title}</a></li>)}</ul>
          {cats.some((c) => c.facet === 'store') && (
            <details class="by-store">
              <summary>Recipes by store ({cats.filter((c) => c.facet === 'store').length} stores)</summary>
              <ul class="chips">{cats.filter((c) => c.facet === 'store').map((c) => <li><a href={c.url}>{c.title}</a></li>)}</ul>
            </details>
          )}
        </>
      )}
    </aside>
  )}

  {!r && related.length > 0 && (
    <section aria-labelledby="related">
      <h2 id="related">Other recipes</h2>
      <RecipeList recipes={related} />
    </section>
  )}
</Base>

<style>
  .more { max-width: var(--measure); padding: 1rem 1.25rem; background: var(--surface); border-radius: var(--leaf-sm); margin: 2.5rem 0; }
  .more p { margin: 0.25rem 0; }
  .chips { list-style: none; padding: 0; margin: 0.4rem 0 0.6rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips a { display: inline-block; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--paper); border: 1px solid var(--rule); text-decoration: none; color: var(--ink); font-size: var(--step--1); }
  .chips a:hover { border-color: var(--basil); }
  .by-store summary { cursor: pointer; font-size: var(--step--1); color: var(--muted); margin-top: 0.4rem; }
</style>
