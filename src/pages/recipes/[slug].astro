---
// One page per recipe: the full recipe (with Recipe schema), where it's featured, and related recipes.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import RecipeList from '../../components/RecipeList.astro';
import { allRecipes, getRecipe, storeStats, homeStore, storeShort, usd } from '../../lib/data';
import { recipeImage } from '../../lib/images';
import { photoFor } from '../../lib/unpriced';
import { categoriesFor } from '../../lib/taxonomy';
import { postsFeaturing } from '../../lib/posts';
import UnpricedRecipe from '../../components/UnpricedRecipe.astro';
import { unpricedRecipes, type Unpriced } from '../../lib/unpriced';

export async function getStaticPaths() {
  return [
    ...allRecipes().map((r) => ({ params: { slug: r.slug }, props: { draft: undefined } })),
    ...(await unpricedRecipes()).map((u) => ({ params: { slug: u.slug }, props: { draft: u } })),
  ];
}

const { draft } = Astro.props as { draft?: Unpriced };

const r = draft ? undefined : getRecipe(Astro.params.slug!);
const s = r && storeStats(r);
const home = r && homeStore(r);
const cats = r ? categoriesFor(r) : [];
const featured = r ? await postsFeaturing(r.slug) : [];
const meal = r?.meal ?? draft!.meal;
const slug = Astro.params.slug!;

// Related: same meal type first, then best protein per dollar.
const related = allRecipes()
  .filter((x) => x.slug !== slug)
  .sort((a, b) => Number(b.meal === meal) - Number(a.meal === meal)
    || (storeStats(b)?.protein_g_per_dollar ?? 0) - (storeStats(a)?.protein_g_per_dollar ?? 0))
  .slice(0, 3);

const description = r
  ? [r.description, `${Math.round(r.protein_g_per_serving)} g protein`, s && home ? `${usd(s.cost_per_serving)} a serving at ${storeShort(home)}.` : '']
      .filter(Boolean).join(' ').slice(0, 155)
  : (draft!.intro[0] ?? `${draft!.title}, a high-protein ${draft!.meal} recipe by ${draft!.author}.`).slice(0, 155);
const name = r?.name ?? draft!.title;
const photo = r ? recipeImage(r.image) : photoFor(draft!);
const ogImage = photo ? new URL(photo.src, Astro.site).href : undefined;
---
<Base title={name} description={description} type="article" image={ogImage}>
  <Breadcrumbs trail={[{ name: 'Home', url: '/' }, { name: 'Recipes', url: '/recipes' }, { name, url: `/recipes/${slug}` }]} />
  {r ? <RecipeCard slug={r.slug} headingLevel={1} /> : <UnpricedRecipe r={draft!} />}

  {(featured.length > 0 || cats.length > 0) && (
    <aside class="more">
      {featured.length > 0 && (
        <p>
          <strong>Part of:</strong>{' '}
          {featured.map((p, i) => <>{i > 0 && ', '}<a href={`/${p.id}`}>{p.data.title}</a></>)}
        </p>
      )}
      {cats.length > 0 && (
        <p><strong>More like this:</strong>{' '}
          {cats.map((c, i) => <>{i > 0 && ', '}<a href={c.url}>{c.title}</a></>)}
        </p>
      )}
    </aside>
  )}

  {related.length > 0 && (
    <section aria-labelledby="related">
      <h2 id="related">Other recipes</h2>
      <RecipeList recipes={related} />
    </section>
  )}
</Base>

<style>
  .more { max-width: var(--measure); padding: 1rem 1.25rem; background: var(--surface); border-radius: var(--leaf-sm); margin: 2.5rem 0; }
  .more p { margin: 0.25rem 0; }
</style>
