---
// Weekly meal planner: pick servings of each recipe, get daily protein/calories/cost and one shopping list
// with the real checkout total. Runs in the browser from the same price book as the rest of the site.
// The plan is saved on the device (localStorage) and in the URL (#d=5&r=slug:4,slug:2) so it can be shared.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import book from '../data/pricebook.json';
import plans from '../data/plans.json';
import { allRecipes, storeStats, usd, monthLabel, STORE, states, storeInfo, priceBasis } from '../lib/data';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{jpg,jpeg,png,webp}', { eager: true });
const meals = ['breakfast', 'lunch', 'dinner', 'snack'];
const label: Record<string, string> = { breakfast: 'Breakfast', lunch: 'Lunch', dinner: 'Dinner', snack: 'Snacks' };
const recipes = allRecipes().filter((r) => Object.keys(r.stores).length);
const stateList = states();
const groups = meals.map((m) => ({ meal: m, list: recipes.filter((r) => r.meal === m) })).filter((g) => g.list.length);
const checked = recipes.flatMap((r) => Object.values(r.stores as Record<string, any>).map((s) => s.prices_checked)).filter(Boolean).sort()[0];

const preset = plans[0];
const data = {
  store: STORE,
  stores: Object.fromEntries(stateList.flatMap((st) => st.ids.map((id) => [id, { ...storeInfo(id), basis: priceBasis(id) }]))),
  recipes: recipes.map((r) => ({
    slug: r.slug, name: r.name, servings: r.servings,
    protein: r.protein_g_per_serving, kcal: r.kcal_per_serving,
    costs: Object.fromEntries(Object.entries(r.stores as Record<string, any>).map(([id, s]) => [id, s.cost_per_serving])),
    ingredients: r.ingredients.filter((i) => !i.optional).map((i) => ({ item: i.item, grams: i.grams })),
  })),
  book,
  preset: preset ? { name: preset.name, days: preset.days, picks: Object.fromEntries(preset.meals.map((m) => [m.recipe, m.servings])) } : null,
};
---
<Base
  title="High-Protein Meal Planner With a Real Shopping List"
  description="Pick your high-protein meals for the week and get daily protein, calories and cost, plus one shopping list with the real checkout total at Walmart, Aldi and more."
>
  <Breadcrumbs trail={[{ name: 'Home', url: '/' }, { name: 'Meal planner', url: '/planner' }]} />
  <header class="head">
    <h1>Plan your week</h1>
    <p class="lede">
      Choose how many servings of each meal you want. You'll get protein, calories and cost per day, and one
      shopping list with what it really costs at the checkout of the store you pick.
    </p>
  </header>

  <div class="layout">
    <section class="pick" aria-labelledby="pick-h">
      <div class="days store-pick">
        <label for="store">Where you shop</label>
        <select id="store">
          {stateList.map((st) => (
            <optgroup label={st.state}>
              {st.ids.map((id) => <option value={id}>{storeInfo(id).store} ({storeInfo(id).city}, {st.market})</option>)}
            </optgroup>
          ))}
        </select>
      </div>
      <div class="days">
        <label for="days">Days you're planning for</label>
        <div class="stepper">
          <button type="button" data-days="-1" aria-label="Fewer days">−</button>
          <output id="days" aria-live="polite">5</output>
          <button type="button" data-days="1" aria-label="More days">+</button>
        </div>
      </div>
      <h2 id="pick-h" class="visually-hidden">Recipes</h2>
      {groups.map((g) => (
        <div class="group">
          <h3>{label[g.meal]}</h3>
          <ul class="cards">
            {g.list.map((r) => {
              const s = storeStats(r, STORE);
              const img = r.image ? images[`../assets/images/${r.image}`]?.default : undefined;
              return (
                <li class="card" data-slug={r.slug}>
                  {img ? <Image src={img} alt="" widths={[160, 320]} sizes="5rem" class="thumb" /> : <span class="thumb" />}
                  <div class="info">
                    <a class="name" href={`/recipes/${r.slug}`}>{r.name}</a>
                    <p class="facts small muted">{Math.round(r.protein_g_per_serving)} g protein · <span class="cost">{s ? usd(s.cost_per_serving) : ''}</span> · makes {r.servings}</p>
                    <p class="na small" hidden>Not every ingredient is sold at this store.</p>
                  </div>
                  <div class="stepper" role="group" aria-label={`Servings of ${r.name}`}>
                    <button type="button" data-step="-1" aria-label={`One less serving of ${r.name}`}>−</button>
                    <output aria-live="polite">0</output>
                    <button type="button" data-step="1" aria-label={`One more serving of ${r.name}`}>+</button>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
      <p class="small muted">More recipes are added every week.</p>
      <a href="#sum-h" class="mbar" id="mbar" hidden></a>
    </section>

    <aside class="summary" aria-labelledby="sum-h">
      <h2 id="sum-h">Your week</h2>
      <div id="empty">
        <p>Add a few meals with the + buttons to see your week and shopping list.</p>
        {data.preset && <button type="button" class="btn" id="preset">Start from our {data.preset.days}-day plan</button>}
      </div>
      <div id="result" hidden>
        <dl class="stats">
          <div><dt>Protein a day</dt><dd id="s-protein"></dd></div>
          <div><dt>Calories a day</dt><dd id="s-kcal"></dd></div>
          <div><dt>Cost a day</dt><dd id="s-cost"></dd></div>
        </dl>
        <p class="small" id="s-note"></p>
        <h3>Shopping list</h3>
        <p class="checkout">At the till: <strong id="s-checkout"></strong></p>
        <div id="list"></div>
        <p class="small" id="pantry"></p>
        <p class="small" id="unpriced" hidden></p>
        <div class="actions">
          <button type="button" class="btn" id="copy">Copy list</button>
          <button type="button" class="btn ghost" id="share">Copy link to this plan</button>
          <button type="button" class="link" id="clear">Clear</button>
        </div>
        <p class="small muted" id="status" aria-live="polite"></p>
      </div>
      <p class="small muted basis"><span id="basis"></span>, checked {monthLabel(checked)}. Your plan is saved on this device.</p>
    </aside>
  </div>

  <section class="prose how" aria-labelledby="how">
    <h2 id="how">How the numbers work</h2>
    <ul>
      <li><strong>Per day</strong> is everything you picked, divided by the days you're planning for.</li>
      <li><strong>At the till</strong> is what you pay: whole packs, rounded up. <strong>Cost a day</strong> counts only what you
        actually eat, so the rest of each pack (most of a bag of rice, say) carries over to next week.</li>
      <li>Spices, oil, salt and other things most kitchens have are listed separately and not added to the till total.</li>
      <li>Prices come from one real store per chain and state. Yours will differ a little. Compare stores on the <a href="/cheapest-protein">cheapest protein</a> pages.</li>
    </ul>
  </section>

  <script type="application/json" id="planner-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type Ing = { item: string; grams: number };
  type R = { slug: string; name: string; servings: number; protein: number; kcal: number; costs: Record<string, number>; ingredients: Ing[] };
  const D = JSON.parse(document.getElementById('planner-data')!.textContent!) as {
    store: string; stores: Record<string, { store: string; city: string; market: string; basis: string }>; recipes: R[];
    book: { aisle_order: string[]; pack_slack: number; items: Record<string, { aisle: string; pantry: boolean; stores: Record<string, { product: string; pack_g: number; price: number; url: string }> }> };
    preset: { name: string; days: number; picks: Record<string, number> } | null;
  };
  const KEY = 'gpd-plan';
  const bySlug = Object.fromEntries(D.recipes.map((r) => [r.slug, r]));
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const usd = (n: number) => `$${n.toFixed(2)}`;
  const clean = (n: string) => n.replace(/\s*\((?!dry\)|frozen\))[^)]*\)/gi, '').replace(/\s+(each|sold by weight)\b/gi, '').replace(/\s+/g, ' ').trim();

  let state: { days: number; picks: Record<string, number> } = { days: 5, picks: {} };
  let store = D.store;
  try { const s = localStorage.getItem('gpd-store'); if (s && D.stores[s]) store = s; } catch {}
  const storeSel = document.getElementById('store') as HTMLSelectElement;

  function load() {
    const h = new URLSearchParams(location.hash.slice(1));
    if (h.get('r')) {
      state.days = Math.min(14, Math.max(1, Number(h.get('d')) || 5));
      for (const pair of h.get('r')!.split(',')) {
        const [slug, n] = pair.split(':');
        if (bySlug[slug] && Number(n) > 0) state.picks[slug] = Math.min(28, Number(n));
      }
      return;
    }
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved?.picks) state = { days: saved.days || 5, picks: Object.fromEntries(Object.entries(saved.picks).filter(([s]) => bySlug[s])) as Record<string, number> };
    } catch {}
  }

  function save() {
    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
    const r = Object.entries(state.picks).filter(([, n]) => n > 0).map(([s, n]) => `${s}:${n}`).join(',');
    history.replaceState(null, '', r ? `#d=${state.days}&r=${r}` : location.pathname);
  }

  function compute() {
    const all = Object.entries(state.picks).filter(([, n]) => n > 0);
    const picked = all.filter(([slug]) => bySlug[slug].costs[store] != null);
    const skipped = all.filter(([slug]) => bySlug[slug].costs[store] == null).map(([slug]) => bySlug[slug].name);
    let protein = 0, kcal = 0, used = 0;
    const need: Record<string, number> = {};
    for (const [slug, n] of picked) {
      const r = bySlug[slug];
      protein += r.protein * n; kcal += r.kcal * n;
      for (const i of r.ingredients) need[i.item] = (need[i.item] || 0) + i.grams * n / r.servings;
    }
    const buy: any[] = [], pantry: string[] = [], unpriced: string[] = [];
    let checkout = 0;
    for (const [item, grams] of Object.entries(need)) {
      const b = D.book.items[item]; const p = b?.stores[store];
      if (!p) { unpriced.push(item); continue; }
      if (p.price === 0) continue;
      used += grams / p.pack_g * p.price;
      if (b.pantry) { pantry.push(item.replace(/ ground| salted/, '')); continue; }
      const packs = Math.max(1, Math.ceil(grams / p.pack_g - D.book.pack_slack));
      checkout += packs * p.price;
      buy.push({ item, aisle: b.aisle, product: clean(p.product), packs, price: packs * p.price, url: p.url, grams });
    }
    const order = Object.fromEntries(D.book.aisle_order.map((a, i) => [a, i]));
    buy.sort((a, b) => (order[a.aisle] ?? 99) - (order[b.aisle] ?? 99) || a.product.localeCompare(b.product));
    return { picked, skipped, protein, kcal, used, checkout, buy, pantry, unpriced };
  }

  function render() {
    storeSel.value = store;
    const info = D.stores[store];
    $('#basis').textContent = info.basis;
    document.querySelectorAll<HTMLLIElement>('.card').forEach((c) => {
      const cost = bySlug[c.dataset.slug!].costs[store];
      (c.querySelector('.cost') as HTMLElement).textContent = cost != null ? usd(cost) : 'not priced here';
      (c.querySelector('.na') as HTMLElement).hidden = cost != null;
      c.classList.toggle('off', cost == null);
      const n = state.picks[c.dataset.slug!] || 0;
      c.querySelector('output')!.textContent = String(n);
      c.classList.toggle('on', n > 0);
    });
    $('#days').textContent = String(state.days);
    const r = compute();
    const mbar = $('#mbar') as HTMLAnchorElement;
    mbar.hidden = r.picked.length === 0;
    $('#empty').hidden = r.picked.length > 0;
    $('#result').hidden = r.picked.length === 0;
    if (!r.picked.length) return;
    const d = state.days;
    $('#s-protein').textContent = `${Math.round(r.protein / d)} g`;
    $('#s-kcal').textContent = `${Math.round(r.kcal / d).toLocaleString('en-US')}`;
    $('#s-cost').textContent = usd(r.used / d);
    const servings = r.picked.reduce((a, [, n]) => a + n, 0);
    $('#s-note').textContent = `${servings} serving${servings > 1 ? 's' : ''} over ${d} day${d > 1 ? 's' : ''}. You'll eat ${usd(r.used)} of what you buy; the rest carries over.`;
    $('#s-checkout').textContent = usd(r.checkout);
    mbar.textContent = `${servings} serving${servings > 1 ? 's' : ''} · ${Math.round(r.protein / d)} g protein a day · ${usd(r.checkout)} at the till ↓`;
    let html = '', aisle = '';
    for (const b of r.buy) {
      if (b.aisle !== aisle) { if (aisle) html += '</ul>'; html += `<p class="aisle">${b.aisle}</p><ul class="items">`; aisle = b.aisle; }
      html += `<li><span>${b.packs > 1 ? `<strong>${b.packs} ×</strong> ` : ''}<a href="${b.url}" rel="nofollow noopener" target="_blank">${b.product}</a></span><span class="num">${usd(b.price)}</span></li>`;
    }
    $('#list').innerHTML = html + (aisle ? '</ul>' : '');
    $('#pantry').innerHTML = r.pantry.length ? `<strong>Already in most kitchens:</strong> ${[...new Set(r.pantry)].join(', ')}.` : '';
    const up = $('#unpriced'); const miss = [...r.unpriced.map((x) => `${x} (not priced)`), ...r.skipped.map((x) => `${x} (not every ingredient sold at ${info.store})`)];
    up.hidden = !miss.length;
    up.textContent = miss.length ? `Left out: ${miss.join('; ')}.` : '';
  }

  function listText() {
    const r = compute();
    const lines = [`My week (${state.days} days) from gramsperdollar.com`, ''];
    for (const [slug, n] of r.picked) lines.push(`${n} × ${bySlug[slug].name}`);
    lines.push('', `Shopping list (${D.stores[store].store}, about ${usd(r.checkout)} at the till):`);
    for (const b of r.buy) lines.push(`- ${b.packs > 1 ? `${b.packs} × ` : ''}${b.product}`);
    if (r.pantry.length) lines.push('', `Check you have: ${[...new Set(r.pantry)].join(', ')}`);
    return lines.join('\n');
  }

  async function copy(text: string, ok: string) {
    try { await navigator.clipboard.writeText(text); $('#status').textContent = ok; }
    catch { $('#status').textContent = 'Couldn’t copy automatically. Select the list and copy it by hand.'; }
  }

  document.querySelectorAll<HTMLLIElement>('.card').forEach((c) => {
    c.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
      const s = c.dataset.slug!;
      state.picks[s] = Math.min(28, Math.max(0, (state.picks[s] || 0) + Number(b.dataset.step)));
      if (!state.picks[s]) delete state.picks[s];
      save(); render();
    }));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-days]').forEach((b) => b.addEventListener('click', () => {
    state.days = Math.min(14, Math.max(1, state.days + Number(b.dataset.days))); save(); render();
  }));
  document.getElementById('preset')?.addEventListener('click', () => { state = { days: D.preset!.days, picks: { ...D.preset!.picks } }; save(); render(); });
  $('#clear').addEventListener('click', () => { state = { days: state.days, picks: {} }; save(); render(); $('#status').textContent = ''; });
  $('#copy').addEventListener('click', () => copy(listText(), 'Shopping list copied.'));
  $('#share').addEventListener('click', () => copy(location.href, 'Link copied. Anyone with it sees this plan.'));

  storeSel.addEventListener('change', () => { store = storeSel.value; try { localStorage.setItem('gpd-store', store); } catch {} render(); });
  load(); save(); render();
</script>

<style>
  .head { max-width: 46rem; }
  .head h1 { font-stretch: 118%; }
  .lede { font-size: var(--step-1); line-height: 1.5; max-width: var(--measure); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 2.5rem; align-items: start; margin-top: 1.5rem; }
  .group h3 { margin: 1.75rem 0 0.5rem; }
  .days { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-block: 1px solid var(--rule); font-family: var(--display); font-weight: 650; }
  .cards { list-style: none; padding: 0; margin: 0; }
  .card { display: grid; grid-template-columns: 4.5rem 1fr auto; gap: 0.9rem; align-items: center; padding: 0.7rem 0; border-top: 1px solid var(--rule); margin: 0; }
  .card:last-child { border-bottom: 1px solid var(--rule); }
  .card :global(.thumb) { width: 4.5rem; height: 4.5rem; object-fit: cover; border-radius: var(--radius); background: var(--rule); display: block; }
  .info { min-width: 0; }
  .name { font-family: var(--display); font-weight: 700; line-height: 1.25; color: var(--ink); text-decoration-color: var(--rule); }
  .facts { margin: 0.2rem 0 0; }
  .stepper { display: inline-flex; align-items: center; border: 1px solid var(--rule); border-radius: 999px; background: var(--paper); }
  .stepper button { width: 2.4rem; height: 2.4rem; border: 0; background: none; font: 700 1.2rem var(--display); color: var(--ink); cursor: pointer; border-radius: 999px; }
  .stepper button:hover { background: var(--basil-soft); }
  .stepper output { min-width: 1.6rem; text-align: center; font-family: var(--display); font-weight: 800; font-variant-numeric: tabular-nums; }
  .card.off { opacity: 0.55; }
  .na { color: var(--muted); margin: 0.15rem 0 0; }
  .store-pick select { font: 650 0.95rem var(--display); padding: 0.45rem 0.6rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper); color: var(--ink); max-width: 60%; }
  .card.on .stepper { border-color: var(--tag); background: var(--tag); color: var(--tag-ink); }
  .card.on .stepper button { color: var(--tag-ink); }
  .summary { position: sticky; top: 1rem; border-top: 3px solid var(--ink); padding-top: 0.75rem; }
  .summary h2 { margin: 0 0 0.75rem; font-size: var(--step-2); }
  .summary h3 { margin: 1.25rem 0 0.25rem; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin: 0; }
  .stats div { display: grid; }
  .stats dt { font-size: var(--step--1); color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--display); font-weight: 800; font-size: var(--step-1); font-variant-numeric: tabular-nums; }
  .checkout { margin: 0 0 0.5rem; }
  .checkout strong { font-family: var(--display); font-size: var(--step-1); background: var(--tag); color: var(--tag-ink); padding: 0.05rem 0.4rem; border-radius: 3px; }
  #list :global(.aisle) { font-family: var(--display); font-weight: 650; font-size: 0.8rem; color: var(--muted); margin: 0.9rem 0 0.2rem; }
  #list :global(.items) { list-style: none; padding: 0; margin: 0; font-size: var(--step--1); }
  #list :global(.items li) { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.35rem 0; border-bottom: 1px dotted var(--rule); margin: 0; }
  #list :global(.items a) { color: var(--ink); text-decoration-color: var(--rule); }
  #list :global(.num) { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 1rem; }
  .btn { font-family: var(--display); font-weight: 700; font-size: 0.95rem; cursor: pointer; background: var(--tag); color: var(--tag-ink); border: 0; border-radius: var(--radius); padding: 0.55rem 0.9rem; box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.14); }
  .btn.ghost { background: none; box-shadow: none; border: 1px solid var(--rule); color: var(--ink); }
  .link { background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font: inherit; font-size: var(--step--1); }
  .basis { margin-top: 1rem; }
  .how { margin-top: 3rem; }
  .mbar { display: none; }
  @media (max-width: 52rem) {
    .layout { grid-template-columns: 1fr; }
    .summary { position: static; }
    .mbar:not([hidden]) {
      display: block; position: sticky; bottom: 0.75rem; margin: 1rem 0 0; z-index: 5; text-align: center;
      background: var(--ink); color: var(--paper); text-decoration: none; font-family: var(--display); font-weight: 650;
      font-size: 0.92rem; padding: 0.75rem 1rem; border-radius: 999px; box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
    }
  }
</style>
