---
// "Where the money goes": each ingredient's cost per serving at one store, with a picker for every store we price.
// The pricing is what makes this site different, so it gets a real table, not a footnote.
// All stores are rendered server-side (crawlable); the picker only shows/hides them.
import { homeStore, storeStats, states, storeInfo, STORE, type Recipe } from '../lib/data';
import MoneyTable from './MoneyTable.astro';

interface Props { r: Recipe; store?: string; level?: number }
const { r, store = homeStore(r) ?? STORE, level = 3 } = Astro.props;
const Hx = `h${level}`;
const groups = states()
  .map((st) => ({ ...st, ids: st.ids.filter((id) => (storeStats(r, id) as any)?.breakdown?.length) }))
  .filter((st) => st.ids.length);
const ids = groups.flatMap((g) => g.ids);
const pick = ids.includes(store) ? store : ids[0];
---
{ids.length > 0 && (
  <section class="money" aria-labelledby={`${r.slug}-money`} data-money>
    <div class="head">
      <Hx id={`${r.slug}-money`}>Where the money goes</Hx>
      {ids.length > 1 && (
        <label class="pick small">Your store
          <select data-money-pick aria-controls={`${r.slug}-money-tables`}>
            {groups.map((g) => (
              <optgroup label={g.state}>
                {g.ids.map((id) => <option value={id} selected={id === pick}>{storeInfo(id).store}, {storeInfo(id).city}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
      )}
    </div>
    <div id={`${r.slug}-money-tables`}>
      {ids.map((id) => (
        <div data-money-store={id} hidden={id !== pick}>
          <MoneyTable r={r} store={id} />
        </div>
      ))}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-money]').forEach((sec) => {
    const sel = sec.querySelector<HTMLSelectElement>('[data-money-pick]');
    if (!sel) return;
    const show = () => sec.querySelectorAll<HTMLElement>('[data-money-store]').forEach((d) => { d.hidden = d.dataset.moneyStore !== sel.value; });
    // Open on the reader's own store if this recipe is priced there.
    try {
      const mine = localStorage.getItem('gpd-store');
      if (mine && [...sel.options].some((o) => o.value === mine)) { sel.value = mine; show(); }
    } catch {}
    sel.addEventListener('change', () => {
      show();
      try { localStorage.setItem('gpd-store', sel.value); } catch {}
      window.dispatchEvent(new CustomEvent('gpd-store', { detail: sel.value }));
    });
  });
</script>

<style>
  .money { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); max-width: 40rem; }
  .money :is(h2, h3) { margin-top: 0; font-size: var(--step-1); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
  .pick { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; }
  .pick select { font: inherit; padding: 0.3rem 0.5rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--paper, #fff); max-width: 15rem; }
</style>
