---
// A multi-day plan: what to eat when, daily totals, and the shopping list grouped by aisle.
import { getPlan, getRecipe, storeStats, usd, num, monthLabel, STORE, PRICE_BASIS } from '../lib/data';

interface Props { slug: string; part: 'week' | 'shopping' }
const { slug, part } = Astro.props;
const plan = getPlan(slug);
const st = (plan.stores as Record<string, any>)[STORE];

const meals = plan.meals.map((m) => {
  const r = getRecipe(m.recipe);
  return { ...m, r, s: storeStats(r) };
});
const checked = meals.map((m) => m.s?.prices_checked).filter(Boolean).sort()[0];

// Shop-friendly product names: drop notes in brackets and "each"/"sold by weight".
const clean = (name: string) =>
  name.replace(/\s*\(.*?\)\s*/g, ' ').replace(/\s+(each|sold by weight)\b/gi, '').replace(/\s+/g, ' ').trim();
const grouped: [string, any[]][] = [];
for (const row of st?.buy ?? []) {
  const last = grouped.at(-1);
  if (last && last[0] === row.aisle) last[1].push(row);
  else grouped.push([row.aisle, [row]]);
}
---
{part === 'week' && (
  <div class="scroll">
    <table class="week">
      <caption class="visually-hidden">{plan.name}: each day</caption>
      <thead>
        <tr><th>Meal</th><th>Recipe</th><th class="num">Protein</th><th class="num kcal">Calories</th><th class="num">Cost</th></tr>
      </thead>
      <tbody>
        {meals.map((m) => (
          <tr>
            <td>{m.slot}</td>
            <td><a href={`#${m.recipe}`}>{m.r.name}</a><span class="note muted">{m.note}</span></td>
            <td class="num">{m.r.protein_g_per_serving} g</td>
            <td class="num kcal">{num(m.r.kcal_per_serving)}</td>
            <td class="num">{m.s ? usd(m.s.cost_per_serving) : ''}</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th colspan="2">Each day</th>
          <th class="num">{plan.per_day.protein_g} g</th>
          <th class="num kcal">{num(plan.per_day.kcal)}</th>
          <th class="num">{st ? usd(st.cost_per_day) : ''}</th>
        </tr>
      </tfoot>
    </table>
  </div>
)}

{part === 'shopping' && st && (
  <div class="shopping">
    <p>
      You'll spend about <strong>{usd(st.checkout_total)}</strong> at the checkout, but the {plan.days} days only use
      about <strong>{usd(st.cost_total_used)}</strong> of it. The rest (most of the whey tub, rice, milk and chicken)
      carries over to next week.
    </p>
    <div class="scroll">
      <table class="list">
        <caption class="visually-hidden">Shopping list, grouped by aisle</caption>
        <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Price</th></tr></thead>
        {grouped.map(([aisle, rows]) => (
          <tbody>
            <tr class="aisle"><th colspan="3" scope="colgroup">{aisle}</th></tr>
            {rows.map((row) => (
              <tr>
                <td>{clean(row.product)}</td>
                <td class="num">{row.packs}</td>
                <td class="num">{usd(row.pack_price * row.packs)}</td>
              </tr>
            ))}
          </tbody>
        ))}
        <tfoot><tr><th colspan="2">Total</th><th class="num">{usd(st.checkout_total)}</th></tr></tfoot>
      </table>
    </div>
    <p class="small"><strong>Already in most kitchens:</strong> {st.pantry.map((p: any) => p.item.replace(/ ground| salted/, '')).join(', ')}.</p>
    <p class="small muted">{PRICE_BASIS}, checked {monthLabel(checked)}. Your store's prices will differ.</p>
  </div>
)}

<style>
  .scroll { overflow-x: auto; margin: 1rem 0 1.25rem; max-width: var(--wide); }
  .note { display: block; font-size: 0.8rem; }
  tfoot th { border-top: 2px solid var(--ink); border-bottom: 0; }
  .list { max-width: 40rem; }
  .aisle th {
    font-size: 0.8rem; color: var(--muted); font-weight: 600;
    padding-top: 1.1rem; border-bottom-color: var(--ink);
  }
  @media (max-width: 34rem) {
    .kcal { display: none; }
    td, th { padding-inline: 0.35rem; }
  }
</style>
