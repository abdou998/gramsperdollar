---
// Recipes ranked by grams of protein per dollar. With several stores, each recipe shows its best-value store.
import { Image } from 'astro:assets';
import ShelfTag from './ShelfTag.astro';
import { bestRecipes, allStoreIds, storeInfo, usd, num, monthLabel, priceBasis } from '../lib/data';
import { recipeImage } from '../lib/images';

interface Props { ids?: string[]; limit?: number }
const { ids = allStoreIds(), limit = 6 } = Astro.props;
const all = bestRecipes(ids);
const rows = all.slice(0, limit);
const many = ids.length > 1;
const checked = all.map((x) => x.s.prices_checked).filter(Boolean).sort()[0];
---
<ol class="board">
  {rows.map(({ r, s, store }) => {
    const img = recipeImage(r.image);
    return (
      <li>
        <a class="card" href={`/recipes/${r.slug}`}>
          <span class="ph">
            {img ? <Image src={img} alt={r.image_alt ?? r.name} widths={[320, 560]} sizes="(min-width: 40rem) 18rem, 100vw" /> : <span class="no-photo"></span>}
            <span class="pin"><ShelfTag value={s.protein_g_per_dollar} size="sm" /></span>
          </span>
          <span class="name">{r.name}</span>
          <span class="facts muted">
            <span>{usd(s.cost_per_serving)} a serving{many && <> at {storeInfo(store).store}</>}</span>
            <span>{Math.round(r.protein_g_per_serving)} g protein</span>
            <span>{num(r.kcal_per_serving)} kcal</span>
          </span>
        </a>
      </li>
    );
  })}
</ol>
<p class="small muted">Ranked by grams of protein per $1. {many ? 'Each recipe at whichever of these stores makes it best value' : priceBasis(ids[0])}, checked {monthLabel(checked)}.</p>

<style>
  .board { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 2rem 1.5rem; }
  .board li { margin: 0; }
  .card { display: grid; gap: 0.45rem; color: var(--ink); text-decoration: none; }
  .ph { position: relative; display: block; aspect-ratio: 4 / 3; margin-bottom: 0.6rem; }
  .ph :global(img), .no-photo { width: 100%; height: 100%; object-fit: cover; border-radius: var(--leaf); display: block; background: var(--surface); }
  .pin { position: absolute; left: -0.4rem; bottom: -0.6rem; }
  .name { font-family: var(--display); font-weight: 700; font-size: var(--step-1); line-height: 1.2; margin-top: 0.3rem; }
  .card:hover .name { color: var(--basil); text-decoration: underline; }
  .facts { font-size: var(--step--1); display: flex; flex-wrap: wrap; gap: 0 0.9rem; }
</style>
