---
// A full recipe (used on /recipes/[slug]): shelf tag, per-serving numbers, ingredients, method, storage, price basis.
// Emits schema.org Recipe JSON-LD so Google can understand it.
import { Image, getImage } from 'astro:assets';
import ShelfTag from './ShelfTag.astro';
import MoneyBreakdown from './MoneyBreakdown.astro';
import StoreCosts from './StoreCosts.astro';
import { howToSteps, SITE_AUTHOR } from '../lib/schema';
import { getRecipe, storeStats, homeStore, storeShort, usd, num } from '../lib/data';

interface Props { slug: string; headingLevel?: 1 | 2 | 3 }
const { slug, headingLevel = 2 } = Astro.props;
const r = getRecipe(slug);
const s = storeStats(r);
const home = homeStore(r);
const H = `h${headingLevel}`;
const Sub = `h${headingLevel + 1}`; // sections sit one level below the recipe title
const isPage = headingLevel === 1;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{jpg,jpeg,png,webp}', { eager: true });
const img = r.image ? images[`../assets/images/${r.image}`]?.default : undefined;

const total = (r.prep_minutes ?? 0) + (r.cook_minutes ?? 0);
// Google asks for the dish photo in 16:9, 4:3 and 1:1 (each at least 50,000 pixels). Cropped from the one photo, centred.
const schemaImages = img
  ? await Promise.all([[1200, 675], [1200, 900], [1200, 1200]].map(async ([w, h]) => {
      const width = Math.floor(Math.min(w, img.width, img.height * w / h)); // never upscale
      const out = await getImage({ src: img, width, height: Math.round(width * h / w), fit: 'cover', format: 'jpg' });
      return new URL(out.src, Astro.site).href;
    }))
  : [];
const hasOptional = r.ingredients.some((i) => i.optional);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: r.name,
  description: r.description,
  recipeYield: `${r.servings} serving${r.servings > 1 ? 's' : ''}`,
  ...(r.prep_minutes ? { prepTime: `PT${r.prep_minutes}M` } : {}),
  ...(r.cook_minutes ? { cookTime: `PT${r.cook_minutes}M` } : {}),
  ...(total ? { totalTime: `PT${total}M` } : {}),
  recipeIngredient: r.ingredients.map((i) => `${i.amount} ${i.label}`),
  recipeInstructions: howToSteps(r.steps ?? [], new URL(`/recipes/${r.slug}`, Astro.site).href),
  ...(r.cuisine ? { recipeCuisine: r.cuisine } : {}),
  author: r.author ? { '@type': 'Person', name: r.author } : SITE_AUTHOR,
  ...(r.meal ? { recipeCategory: r.meal } : {}),
  keywords: ['high protein', 'meal prep', ...(r.meal ? [r.meal] : []), ...((r.tags as string[] | undefined) ?? [])].join(', '),
  nutrition: {
    '@type': 'NutritionInformation',
    servingSize: '1 serving',
    calories: `${r.kcal_per_serving} calories`,
    proteinContent: `${r.protein_g_per_serving} g`,
  },
  ...(schemaImages.length ? { image: schemaImages } : {}),
  ...(r.published ? { datePublished: r.published } : {}),
};
---
<section class:list={["recipe", { page: headingLevel === 1 }]} id={slug} aria-labelledby={`${slug}-title`}>
  <header class="head">
    <ShelfTag value={s?.protein_g_per_dollar} />
    <div>
      <H id={`${slug}-title`} class="title">{r.name}</H>
      {r.description && <p class="desc">{r.description}</p>}
      {r.author && <p class="byline small muted">By {r.author}</p>}
    </div>
  </header>

  <dl class="stats">
    <div><dt>Protein</dt><dd>{r.protein_g_per_serving} g</dd></div>
    <div><dt>Calories</dt><dd>{num(r.kcal_per_serving)}</dd></div>
    {s && home && <div><dt>Cost at {storeShort(home)}</dt><dd>{usd(s.cost_per_serving)}</dd></div>}
    <div><dt>Makes</dt><dd>{r.servings} serving{r.servings > 1 ? 's' : ''}</dd></div>
    {total > 0 && <div><dt>Time</dt><dd>{total} min</dd></div>}
  </dl>
  {s && (
    <p class="add">
      <button type="button" class="btn add-btn" data-add-slug={r.slug} data-add-n={r.servings}>Add to my week</button>
      <span class="add-status small" aria-live="polite"></span>
    </p>
  )}
  <p class="per small muted">Protein, calories and cost are per serving{hasOptional ? ', without the optional extras' : ''}.</p>

  {img && (
    <figure class="photo">
      <Image src={img} alt={r.image_alt ?? r.name} widths={[480, 800, 1120]} sizes="(min-width: 56rem) 56rem, 100vw" loading={isPage ? 'eager' : 'lazy'} fetchpriority={isPage ? 'high' : 'auto'} />
      {r.image_credit && <figcaption class="small muted">{r.image_credit}</figcaption>}
    </figure>
  )}

  {r.intro && <p class="intro">{r.intro}</p>}

  <div class="cols">
    <div>
      <Sub>Ingredients</Sub>
      <ul class="ingredients">
        {r.ingredients.map((i) => (
          <li><span class="amt">{i.amount}</span> {i.label}</li>
        ))}
      </ul>
    </div>
    <div>
      <Sub>Method</Sub>
      <ol class="steps">
        {(r.steps ?? []).map((step, i) => <li id={`step-${i + 1}`}>{step}</li>)}
      </ol>
    </div>
  </div>

  {r.storage && (<><Sub>Storing it</Sub><p>{r.storage}</p></>)}
  {r.tip && (<><Sub>Make it cheaper</Sub><p>{r.tip}</p></>)}

  {isPage && (
    <section class="rate" data-rate-slug={r.slug} hidden aria-labelledby={`${r.slug}-rate`}>
      <Sub id={`${r.slug}-rate`}>Made it? Rate it</Sub>
      <p class="rate-sum small" aria-live="polite"></p>
      <div class="stars" role="group" aria-label="Your rating">
        {[1, 2, 3, 4, 5].map((n) => <button type="button" data-stars={n} aria-label={`${n} star${n > 1 ? 's' : ''}`}>★</button>)}
      </div>
      <p class="rate-msg small muted" aria-live="polite"></p>
    </section>
  )}
  <MoneyBreakdown r={r} level={headingLevel + 1} />
  <StoreCosts r={r} level={headingLevel + 1} />

  <script type="application/ld+json" data-recipe-ld set:html={JSON.stringify(schema)} />
</section>

<script>
  // Reader ratings: hidden until the ratings service is switched on; one vote per visitor (can be changed).
  document.querySelectorAll<HTMLElement>('[data-rate-slug]').forEach(async (box) => {
    const slug = box.dataset.rateSlug!;
    const sum = box.querySelector('.rate-sum') as HTMLElement;
    const msg = box.querySelector('.rate-msg') as HTMLElement;
    const btns = [...box.querySelectorAll<HTMLButtonElement>('[data-stars]')];
    const mark = (n: number) => btns.forEach((b) => b.classList.toggle('on', Number(b.dataset.stars) <= n));
    const show = (d: { count: number; average: number | null }) => {
      sum.textContent = d.count ? `${d.average} out of 5 from ${d.count} rating${d.count > 1 ? 's' : ''}` : 'No ratings yet. Be the first.';
    };
    let mine = 0;
    try { mine = Number(localStorage.getItem(`gpd-rated-${slug}`)) || 0; } catch {}
    try {
      const d = await (await fetch(`/api/rating?slug=${slug}`)).json();
      if (!d.enabled) return;
      show(d); mark(mine); box.hidden = false;
      if (mine) msg.textContent = `You rated it ${mine}. Tap again to change.`;
    } catch { return; }
    btns.forEach((b) => b.addEventListener('click', async () => {
      const n = Number(b.dataset.stars); mark(n);
      try {
        const r = await fetch('/api/rate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug, stars: n }) });
        const d = await r.json();
        if (!r.ok) { msg.textContent = d.error || 'Could not save your rating.'; return; }
        show(d); msg.textContent = `Thanks! You rated it ${n}.`;
        try { localStorage.setItem(`gpd-rated-${slug}`, String(n)); } catch {}
      } catch { msg.textContent = 'Could not save your rating. Try again.'; }
    }));
  });

  // "Add to my week": adds one batch of this recipe to the planner saved on this device.
  document.querySelectorAll<HTMLButtonElement>('.add-btn').forEach((b) => b.addEventListener('click', () => {
    const status = b.nextElementSibling as HTMLElement;
    try {
      const plan = JSON.parse(localStorage.getItem('gpd-plan') || 'null') ?? { days: 5, picks: {} };
      const slug = b.dataset.addSlug!; const n = Number(b.dataset.addN) || 1;
      plan.picks[slug] = Math.min(28, (plan.picks[slug] || 0) + n);
      localStorage.setItem('gpd-plan', JSON.stringify(plan));
      status.innerHTML = `Added (${plan.picks[slug]} serving${plan.picks[slug] > 1 ? 's' : ''} in your week). <a href="/planner">Open the planner</a>`;
    } catch {
      status.innerHTML = `Couldn't save on this device. <a href="/planner#d=5&r=${b.dataset.addSlug}:${b.dataset.addN}">Open it in the planner</a>`;
    }
  }));
</script>

<style>
  .recipe {
    max-width: var(--wide);
    margin: 3rem 0;
    padding: 1.5rem 0 0;
    border-top: 2px solid var(--rule);
  }
  .head { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; align-items: start; }
  .title { margin: 0 0 0.35rem; font-size: var(--step-3); letter-spacing: -0.03em; }
  .recipe.page { margin-top: 0.5rem; border-top: 0; padding-top: 0; }
  .desc { margin: 0; color: var(--muted); max-width: var(--measure); }
  .byline { margin: 0.4rem 0 0; }
  .intro { max-width: var(--measure); margin: 0 0 1.5rem; }
  .stats {
    display: flex; flex-wrap: wrap; gap: 0.5rem 2rem;
    margin: 1.5rem 0 0.25rem; padding: 0.9rem 1.25rem;
    background: var(--surface); border-radius: var(--leaf-sm);
  }
  .stats div { display: grid; }
  .stats dt { font-size: var(--step--1); color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--display); font-weight: 750; font-size: var(--step-1); font-variant-numeric: tabular-nums; }
  .per { margin: 0.4rem 0 1.5rem; }
  .add { margin: 0.9rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; align-items: center; }
  .photo { margin: 0 0 1.5rem; max-width: 40rem; }
  .photo :global(img) { border-radius: var(--leaf); width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .photo figcaption { margin-top: 0.4rem; }
  .cols { display: grid; grid-template-columns: minmax(14rem, 1fr) 2fr; gap: 0 2.5rem; }
  .cols :is(h2, h3) { margin-top: 0.5rem; font-size: var(--step-1); }
  .recipe > :is(h2, h3) { font-size: var(--step-1); }
  .ingredients { list-style: none; padding: 0; }
  .ingredients li { padding: 0.3rem 0; border-bottom: 1px dotted var(--rule); margin: 0; }
  .amt { font-family: var(--display); font-weight: 650; }
  .steps { padding-left: 1.3rem; }
  .steps li { padding-left: 0.3rem; margin-bottom: 0.7em; }
  .steps li::marker { font-family: var(--display); font-weight: 800; color: var(--basil); }
  .basis { margin-top: 1.5rem; }
  .rate { margin-top: 2rem; padding: 1rem 1.25rem; background: var(--surface); border-radius: var(--leaf-sm); max-width: 40rem; }
  .rate :is(h2, h3) { margin: 0 0 0.25rem; font-size: var(--step-1); }
  .rate-sum, .rate-msg { margin: 0.25rem 0; }
  .stars { display: flex; gap: 0.25rem; }
  .stars button { font-size: 1.9rem; line-height: 1; background: none; border: 0; cursor: pointer; color: var(--rule); padding: 0.1rem; }
  .stars button.on, .stars button:hover { color: #e0a400; }
  @media (max-width: 44rem) {
    .cols { grid-template-columns: 1fr; }
    .head { grid-template-columns: 1fr; }
  }
</style>
