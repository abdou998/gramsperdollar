// Cloudflare deploy config.
// Pages are static files from dist/ (free, no server code runs for them).
// Only /api/* runs the small Worker in worker/index.ts, which powers the private /write page.
{
  "name": "gramsperdollar",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /about serves about.html; one clean URL per page
    "html_handling": "drop-trailing-slash",
    // unknown addresses get dist/404.html with a real 404 status
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/recipes/*"]
  },
  "vars": {
    "GITHUB_REPO": "abdou998/gramsperdollar",
    "GITHUB_BRANCH": "main"
  }
  // Reader ratings: add the KV namespace id here once it exists, then ratings switch on by themselves:
  // "kv_namespaces": [{ "binding": "RATINGS", "id": "<id from Cloudflare → Storage & Databases → KV>" }],
  // Secrets (set in the Cloudflare dashboard, never in this file): WRITER_PASSWORD, GITHUB_TOKEN
}
